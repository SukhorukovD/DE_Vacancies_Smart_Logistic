# Настройки локального демо
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://postgres:postgres@postgres:5432/airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=True
AIRFLOW__CORE__PARALLELISM=2
AIRFLOW__SCHEDULER__PARSING_PROCESSES=1

AIRFLOW__CORE__EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/
AIRFLOW__API_AUTH__JWT_SECRET=local-demo-only-change-before-public-deployment
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

PYTHONPATH=/opt/airflow

PGHOST=postgres
PGPORT=5432
PGDATABASE=dwh
PGUSER=postgres
PGPASSWORD=postgres

CH_URL=http://clickhouse:8123
CH_USER=default
CH_PASSWORD=

ML_DB=ml
# Stable local Airflow login; password is generated into the named volume.
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_USERS=admin:admin
AIRFLOW__CORE__SIMPLE_AUTH_MANAGER_PASSWORDS_FILE=/opt/airflow/state/simple_auth_manager_passwords.json
